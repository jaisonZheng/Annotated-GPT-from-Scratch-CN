+#【手搓版本的LayerNorm，实际上并没有用到】
+class LayerNorm:
+    def __init__(self, dim, eps=1e-5):
+        self.eps = eps
+        self.gamma = torch.ones(dim)
+        self.beta = torch.zeros(dim) # 两个可学习参数
+
+
+    def __call__(self, x):
+        # LayerNorm不分训练模式和推理模式
+        xmean = x.mean(1, keepdim=True) # 计算均值
+        xvar = x.var(1, keepdim=True)   # 计算方差       
+        # 注意，如果是BatchNorm，上面两个1应该为0
+        # BatchNorm沿batch维度（列）计算不同样本的均值和方差 
+        # 而Hinton说：“我们应关注神经元之间的均值和方差，而不是关注样本”
+        # 所以LayerNorm是沿行方向的
+
+        # 标准化
+        xhat = (x - xmean) / torch.sqrt(xvar + self.eps) 
+        # 分母有个epsilon是为了防止除以0
+
+        # y = gamma \odot x + beta （odot意为逐元素相乘）
+        self.out = self.gamma * xhat + self.beta
+        return self.out
 
+    def parameters(self):
+        return [self.gamma, self.beta]
 
 class Block(nn.Module):
     """Transformer的单个组件"""
 
     def __init__(self, n_embd, n_heads):
         super().__init__()
         head_size = n_embd // n_heads
         self.sa = MultiHeadAttention(n_heads, head_size) # sa是self-attention的缩写
         self.ffwd = FeedForward(n_embd)
+        # 不能共用同一个LayerNorm对象，是因为每个LayerNorm有自己的gamma和beta
+        self.ln1 = nn.LayerNorm(n_embd)
+        self.ln2 = nn.LayerNorm(n_embd)
 
